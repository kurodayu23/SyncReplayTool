# ---- Qt / qmake 生成物 ----
Makefile
Makefile.*
.qmake.stash
moc_*.cpp
moc_*.h
ui_*.h
qrc_*.cpp
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.exp
*.res
debug/
release/

# ---- IDE / 本机配置（含本机绝对路径，不该进仓库）----
*.pro.user
*.user
.qtc_clangd/
.qtcreator/
.vs/
.vscode/
*.sln
*.vcxproj
*.vcxproj.filters

# ---- 交付产物与打包中间物 ----
deliverables/
*.tar.gz
*.zip
*.iso
*.app
*.desktop~

# 交付包与本机配置不入库：成品按客户单独发送，不随源码走；
# 上面的 *.zip / *.tar.gz 已经挡住了它们，这里只说明原因，
# 免得以后有人看到"仓库里没有包"又去加例外。

# ---- 密钥、口令、私钥：绝不进仓库 ----
*.pem
*.key
*.p12
*.pfx
*.ppk
*.asc
id_rsa*
id_ed25519*
authorized_keys
ssh_host_*

# ---- 历史事故残留：曾经被写进源码树的本机垃圾 ----
# 起因是把 /usr/bin/... 之类的绝对路径当相对路径执行，于是
# usr\ etc\ home\ tmp\ 整棵目录树长在了源码树里（etc\ssh 里还有主机私钥）。
NUL
usr/
etc/
home/
tmp/
60000/
zz_probe.txt

# ---- 编辑器临时文件 ----
*~
*.orig
*.rej
*.bak

# ---- 测试台的工作产物（不进仓库）----
# work/ 是测试与 GUI 会话的工作根，默认落在仓库外的
# AP7000-Build-Directories\SyncReplayTool\work；
# 但带 SRT_CONFIG_DIR 覆盖、或从源码目录启动产品时，会在仓库里长出
# work/w02/cfg（配置）+ work/<段>/logs（日志）。挡掉，别让 git status 变脏。
work/
# 端到端 argv 抓取的 app 目录：平铺的 exe + DLL + 记录器（上百个文件），
# 是每次跑都重新生成的现场，不该进仓库。
# 默认建在仓库外（ai-workspace\SyncReplayTool\argv-app），
# 但用 SRT_ARGV_APPDIR 覆盖时可能落在仓库里，这里一并挡住。
scripts/tests/argv_capture/app/
scripts/tests/**/app/
argv-app/
# 抓取台架的运行产物（每次跑都重新生成）
scripts/tests/argv_capture/argv-dump.txt
scripts/tests/argv_capture/secrets-report.txt

# ---- Python 字节码缓存 ----
__pycache__/
*.pyc
